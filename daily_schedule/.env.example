# ── Claude API ────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...


# ── Todoist ───────────────────────────────────────────────────────────────────
# Settings → Integrations → Developer → API token
TODOIST_API_TOKEN=...


# ── Microsoft Outlook (Graph API) ─────────────────────────────────────────────
# 1. Go to https://portal.azure.com → Azure Active Directory → App registrations
# 2. Click "New registration"
#    - Name: Daily Schedule Bot (anything you like)
#    - Supported account types: "Accounts in any organizational directory and personal Microsoft accounts"
#    - Redirect URI: leave blank
# 3. After creation, copy the "Application (client) ID" below
# 4. Go to "Authentication" → enable "Allow public client flows" (toggle ON) → Save
# 5. Go to "API permissions" → Add permission → Microsoft Graph → Delegated
#    Add: Calendars.Read, User.Read
#    Click "Grant admin consent" if you're on a work tenant, otherwise it's automatic.
#
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Use "common" for personal Microsoft accounts (Outlook.com / Hotmail).
# Use your tenant ID or domain for a work/school Office 365 account.
AZURE_TENANT_ID=common


# ── Personal preferences ──────────────────────────────────────────────────────

# Your local timezone (IANA format)
# Examples: Europe/London, America/New_York, America/Chicago, Europe/Dublin
TIMEZONE=Europe/London

# Door-to-desk commute time in minutes
COMMUTE_MINUTES=30

# Optional: describe your working pattern so Claude can factor it in
# e.g. "Hybrid – Tuesday and Thursday in the office, remote other days"
WORKING_PATTERN=
