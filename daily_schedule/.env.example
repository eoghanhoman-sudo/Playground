# ── Claude API ────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...


# ── Apple / iCloud ────────────────────────────────────────────────────────────
# Your Apple ID (iCloud email address)
APPLE_ID=you@icloud.com

# App-specific password — NOT your main Apple ID password.
# Generate one at: https://appleid.apple.com → Sign-In & Security → App-Specific Passwords
# Click "+", name it "Daily Schedule", copy the xxxx-xxxx-xxxx-xxxx password below.
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx


# ── Personal preferences ──────────────────────────────────────────────────────

# Your local timezone (IANA format)
# Examples: Europe/London, Europe/Dublin, America/New_York, America/Chicago
TIMEZONE=Europe/London

# What time you leave home each morning (24h format)
DEPARTURE_TIME=07:00

# How long your commute takes in minutes
COMMUTE_MINUTES=30

# Optional: limit to specific Apple Calendar names (comma-separated).
# Leave blank to include ALL calendars (recommended to start).
# Example: Personal,Family,Health & Fitness
CALENDAR_FILTER=
