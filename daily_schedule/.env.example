# ── Claude API ────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...


# ── Apple / iCloud ────────────────────────────────────────────────────────────
# Your Apple ID (iCloud email address)
APPLE_ID=you@icloud.com

# App-specific password — NOT your main Apple ID password.
# 1. Go to https://appleid.apple.com → Sign-In & Security → App-Specific Passwords
# 2. Click "+" and name it "Daily Schedule"
# 3. Copy the xxxx-xxxx-xxxx-xxxx password here
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx


# ── Weather (Open-Meteo — free, no API key needed) ────────────────────────────
# Find your coordinates at https://www.latlong.net/
# Leave blank to skip weather.
LATITUDE=51.5074
LONGITUDE=-0.1278


# ── Personal preferences ──────────────────────────────────────────────────────

# Your local timezone (IANA format)
# Examples: Europe/London, Europe/Dublin, America/New_York, America/Chicago
TIMEZONE=Europe/London

# Time you leave home each morning (24h)
DEPARTURE_TIME=07:00

# Door-to-destination commute in minutes
COMMUTE_MINUTES=30

# Optional: restrict to specific Apple Calendar names (comma-separated).
# Leave blank to include ALL calendars (recommended).
# Example: Personal,Family,Health & Fitness
CALENDAR_FILTER=


# ── macOS Notification ────────────────────────────────────────────────────────
# Sends a Notification Centre alert when the plan is ready.
# Set to "false" to disable.
NOTIFY_MAC=true


# ── Email delivery ────────────────────────────────────────────────────────────
# Leave EMAIL_TO blank to skip email entirely.
#
# Gmail:
#   EMAIL_SMTP_HOST=smtp.gmail.com
#   EMAIL_SMTP_PORT=587
#   EMAIL_PASSWORD= (Gmail app password — myaccount.google.com → Security → App passwords)
#
# iCloud Mail:
#   EMAIL_SMTP_HOST=smtp.mail.me.com
#   EMAIL_SMTP_PORT=587
#   EMAIL_PASSWORD= (iCloud app-specific password — same as APPLE_APP_PASSWORD is fine)
#
EMAIL_TO=you@gmail.com
EMAIL_FROM=you@gmail.com
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
